{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:synapse:schema:catalog-trust-root-v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "publishers": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "peer_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "public_key": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "minItems": 1,
            "maxItems": 128
          }
        },
        "required": [
          "peer_id",
          "public_key"
        ]
      }
    },
    "revoked_publishers": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "revoked_models": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  },
  "required": [
    "schema_version",
    "publishers",
    "revoked_publishers",
    "revoked_models"
  ]
}
