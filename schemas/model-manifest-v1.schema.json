{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:synapse:schema:model-manifest:1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "model_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+$",
      "not": {
        "enum": [
          "main",
          "master"
        ]
      }
    },
    "weights": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^(?!\\.)(?!.*\\.\\.)[A-Za-z0-9_.-]+$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10000,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:synapse:schema:model-artifact:1",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^(?!\\.)(?!.*\\.\\.)[A-Za-z0-9_.-]+$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 18446744073709551615
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          }
        },
        "required": [
          "filename",
          "size_bytes",
          "sha256"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "model_id",
    "revision",
    "weights",
    "artifacts"
  ]
}
