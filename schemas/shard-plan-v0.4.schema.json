{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:synapse:schema:shard-plan:0.4",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "total_layers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "layer_start": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "layer_end": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "dtype": {
      "enum": [
        "F32",
        "F16",
        "BF16",
        "I64"
      ]
    },
    "max_sequence_len": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    }
  },
  "required": [
    "total_layers",
    "layer_start",
    "layer_end",
    "dtype",
    "max_sequence_len"
  ]
}
