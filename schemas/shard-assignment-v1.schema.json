{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:synapse:schema:shard-assignment-v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{16}$"
        },
        "route_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "model_digest": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      },
      "required": [
        "session_id",
        "route_epoch",
        "model_digest"
      ]
    },
    "layer_start": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1023
    },
    "layer_end": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "total_layers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "context_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "memory_limit_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "ttl_ms": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 300000
    }
  },
  "required": [
    "protocol_version",
    "key",
    "layer_start",
    "layer_end",
    "total_layers",
    "context_tokens",
    "memory_limit_bytes",
    "ttl_ms"
  ]
}
